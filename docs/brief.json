  {
   "lead": "Korea had a very bad Friday, and your biggest fund has not priced it yet.",
   "text": "KOSPI fell 6.02% to 5,059.69 on Friday, with SK hynix down 10.44% and Samsung down 6.35%. This morning your dashboard prices SCBKEQTG at its 4 Nov NAV, before a market move of about 11% since then. The 11:30 refresh may show more.",
   "dir": "neg",
   "exposure_pct": 17.0,
   "exposure_label": "Korea"
  },
  {
   "lead": "The AI-spending worry that hit Korea also hit US tech.",
   "text": "The Nasdaq had its biggest one-day fall in 19 months on Thursday, on fears Democratic control of Congress slows AI data centre building. It bounced 1.09% on Friday. ES-US500RMF and K-USA-A(D) are priced at 4 Nov, about 4% of S&P 500 decline behind.",
   "dir": "neg",
   "exposure_pct": 17.0,
   "exposure_label": "United States"
  },
  {
   "lead": "A strong US jobs report revived talk of another Fed rate rise.",
   "text": "US employers added 165,000 jobs last month, more than twice forecasts. Markets now price about an 80% chance of a quarter-point rise on 9 Dec, up from about 67%. The US 10-year yield ended Friday at 4.86%.",
   "dir": "watch",
   "exposure_pct": 25.0,
   "exposure_label": "United States"
  }
 ],
